{
  "name": "@fatidian1/mpnp",
  "version": "0.1.1",
  "description": "Transparent bridge translating npm commands and flags into high-performance pnpm equivalents",
  "keywords": [
    "bridge",
    "cli",
    "compatibility",
    "converter",
    "npm",
    "package-manager",
    "pnpm",
    "translator"
  ],
  "homepage": "https://github.com/fatidian1/mpnp#readme",
  "bugs": {
    "url": "https://github.com/fatidian1/mpnp/issues"
  },
  "license": "MIT",
  "author": "fatidian1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatidian1/mpnp.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/fatidian1"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/fatidian1"
    }
  ],
  "bin": {
    "npm": "./dist/npm.mjs",
    "npx": "./dist/npx.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "tsdown",
    "prepublishOnly": "vitest run && tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "type:check": "tsc --noEmit",
    "dep:check": "knip"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-config-universe": "^0.2.0",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "npm": "12.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": "^12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
